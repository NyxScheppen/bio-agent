# backend/.env_example
# 复制此文件为 .env 并填入真实值
# Copy this file to .env and fill in real values

# DeepSeek API 配置
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
MODEL_NAME=deepseek-chat

# 服务配置
API_HOST=127.0.0.1
API_PORT=8000

# 上传资源限制（字节；MAX_UPLOAD_FILES 为文件数）
MAX_UPLOAD_FILES=20
MAX_UPLOAD_FILE_BYTES=104857600
MAX_UPLOAD_BATCH_BYTES=262144000

# 表格预览资源限制（字节）
MAX_PREVIEW_SCAN_BYTES=67108864
MAX_PREVIEW_DECOMPRESSED_BYTES=134217728
MAX_PREVIEW_LINE_BYTES=2097152
